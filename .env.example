# Address for the ports a person actually opens: Grafana (:3000), Orbit Shop
# (:8081), and the OTLP receiver (:4317 gRPC, :4318 HTTP).
# 127.0.0.1 keeps them on localhost. Set a Tailscale or LAN address to open
# them from another machine.
# Prometheus (:9090) and Loki (:3100) always stay on 127.0.0.1.
# NOTE: The collector has no auth. Do not publish it on a network you do not trust.
BIND_ADDR=127.0.0.1
