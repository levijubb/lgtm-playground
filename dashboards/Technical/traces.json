            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "insertNulls": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
